{
  "name": "mapa-atlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "layout": "node layout.mjs",
    "build:graph": "tsc --noEmit && vite build",
    "build:atlas": "tsc --noEmit && vite build --config vite.v3.atlas.config.ts",
    "build:lab": "tsc --noEmit && vite build --config vite.v3.lab.config.ts",
    "build:all": "npm run build:graph && npm run build:atlas && npm run build:lab",
    "build": "npm run build:all"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@sigma/node-border": "^3.0.0",
    "@vitejs/plugin-react": "4.6.0",
    "3d-force-graph": "^1.80.0",
    "dompurify": "3.4.12",
    "graphology": "0.26.0",
    "graphology-communities-louvain": "^2.0.2",
    "graphology-layout-forceatlas2": "0.10.1",
    "lucide-react": "^1.27.0",
    "marked": "^18.0.5",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "sigma": "3.0.2",
    "three-spritetext": "^1.10.0",
    "typescript": "5.8.3",
    "vite": "7.3.6"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^29.1.1",
    "playwright": "^1.61.1",
    "postcss": "8.5.24"
  }
}
